# Application
APP_ENV=development
APP_NAME=FDE Forge AI
APP_TAGLINE=Transform AI Engineers into Customer-Ready Forward Deployed Engineers.
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET=change-me-csrf-secret-key-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (Docker/EC2 = Postgres; TCS Mac native = SQLite via setup.sh)
DATABASE_URL=postgresql+asyncpg://fde:fde_secret@postgres:5432/fde_forge
DATABASE_URL_SYNC=postgresql://fde:fde_secret@postgres:5432/fde_forge

# Redis / Celery (optional on TCS SQLite mode)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Storage: s3 (MinIO/Docker) or local (TCS Mac)
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=.run/uploads

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fde-forge
S3_REGION=us-east-1
S3_USE_SSL=false

# OpenAI / AI Gateway
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DEFAULT_PROVIDER=openai
DEFAULT_LLM_PROVIDER=openai
ENABLED_LLM_PROVIDERS=openai,bedrock
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=180
AI_DAILY_ORG_BUDGET=50.00
AI_FALLBACK_MODEL=

# AWS Bedrock (TCS Mac / AWS only — leave disabled for local OpenAI Macs)
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure OpenAI (optional — adapter ready)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Anthropic (optional — adapter ready)
ANTHROPIC_API_KEY=

# AWS Bedrock (optional — adapter ready)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Google Gemini (optional — adapter ready)
GOOGLE_API_KEY=
GEMINI_MODEL=

# Email (MailHog for local)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fdeforge.example.com
SMTP_USE_TLS=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=fde-forge-api
SENTRY_DSN=
LOG_LEVEL=INFO

# Uploads & Code Execution
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt,md
CODE_EXECUTION_TIMEOUT_SECONDS=30
CODE_EXECUTION_MEMORY_LIMIT_MB=512
CODE_EXECUTION_ENABLED=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Seed (development only)
SEED_ADMIN_EMAIL=saurabh@fdeforge.example.com
SEED_ADMIN_PASSWORD=admin123
SEED_LEARNER_PASSWORD=ChangeMeLearner123!
